---
const navLinks = [
  { label: "Home", href: "/", active: true },
  {
    label: "About RBAP",
    href: "#",
    dropdown: [
      { label: "History", href: "#" },
      { label: "Mission & Vision", href: "/about/mission-vision" },
      { label: "Confederations", href: "/about/confederations" },
      { label: "Federations", href: "/about/federations" },
      { label: "Officers & Employees", href: "/about/officers-and-employees" },
      { label: "Organizational Chart", href: "#" },
    ],
  },
  {
    label: "Programs & Services",
    href: "#",
    dropdown: [
      { label: "Microfinance Loans & Deposits", href: "/services/MicrofinanceLoansDeposits" },
      { label: "Salary Loans", href: "/services/SalaryLoans" },
      { label: "Agricultural Loans", href: "/services/AgriculturalLoans" },
      { label: "Deposit Services", href: "/services/DepositServices" },
      { label: "Payment of Bills", href: "/services/PaymentofBills" },
      { label: "Remittances", href: "/services/Remittances" },
    ],
  },
  { label: "News & Events", href: "/news&events/events" },
  { label: "Locate a Bank", href: "/locate-a-bank" },
  { label: "Contact Us", href: "/contact/contact-us" },
];
---

<header class="sticky top-0 z-[1000] bg-white shadow-sm border-b border-gray-100">
  <!-- Top Bar -->
  <div class="bg-green-800 text-white text-xs py-1.5 px-4">
    <div class="max-w-screen-xl mx-auto flex items-center justify-between">
      <span class="hidden sm:block">Empowering Rural Banks in the Philippines since 1955</span>
      <div class="flex items-center gap-4 ml-auto">
        <a href="https://www.facebook.com/rbapofficial" target="_blank" rel="noopener" class="hover:text-green-200 transition-colors" aria-label="Facebook">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/></svg>
        </a>
        <a href="https://twitter.com/rbap_ph" target="_blank" rel="noopener" class="hover:text-green-200 transition-colors" aria-label="Twitter">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/></svg>
        </a>
        <a href="https://www.youtube.com/rbap" target="_blank" rel="noopener" class="hover:text-green-200 transition-colors" aria-label="YouTube">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd"/></svg>
        </a>
        <span class="border-l border-green-600 pl-4">
          <a href="tel:+6328921-4184" class="hover:text-green-200 transition-colors">(02) 8921-4184</a>
        </span>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <nav class="bg-white px-4 lg:px-6 py-3">
    <div class="flex flex-wrap justify-between items-center mx-auto max-w-screen-xl">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/rbap-icon.png"
          alt="RBAP Emblem"
          class="h-11 w-11 object-contain transition-opacity group-hover:opacity-90"
        />
        <div class="leading-tight">
          <div class="font-extrabold text-green-800 text-sm tracking-tight">Rural Bankers Association</div>
          <div class="text-gray-500 text-[10px] leading-tight">of the Philippines</div>
        </div>
      </a>

      <!-- Mobile toggle -->
      <button
        id="navbar-toggle"
        type="button"
        class="inline-flex items-center p-2 ml-1 text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200"
        aria-controls="navbar-main"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg id="icon-open" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
        </svg>
        <svg id="icon-close" class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>

      <!-- Nav Links -->
      <div class="hidden w-full lg:flex lg:w-auto lg:items-center" id="navbar-main">
        <ul class="flex flex-col mt-4 font-medium lg:flex-row lg:space-x-1 lg:mt-0">
          {navLinks.map((link) =>
            link.dropdown ? (
              <li class="relative group">
                <button class={`flex items-center gap-1 py-2 px-3 text-sm rounded-md transition-colors ${link.active ? "text-green-700 font-semibold" : "text-gray-700 hover:text-green-700 hover:bg-green-50"}`}>
                  {link.label}
                  <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </button>
                <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50 min-w-[200px]">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    {link.dropdown.map((item) => (
                      <a href={item.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700 transition-colors">
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={link.href}
                  class={`block py-2 px-3 text-sm rounded-md transition-colors ${link.active ? "text-green-700 font-semibold bg-green-50" : "text-gray-700 hover:text-green-700 hover:bg-green-50"}`}
                  aria-current={link.active ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            )
          )}
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('navbar-toggle');
  const menu = document.getElementById('navbar-main');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', !isHidden);
    iconOpen?.classList.toggle('hidden', isHidden ?? false);
    iconClose?.classList.toggle('hidden', !isHidden);
  });
</script>