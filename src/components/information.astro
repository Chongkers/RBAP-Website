---
const newsItems = [
  {
    id: "news-1",
    category: "Event",
    categoryColor: "bg-green-100 text-green-700",
    date: "September 21, 2026",
    title: "Courtesy Meeting with BSP Monetary Board Member Romeo L. Bernardo",
    excerpt: "RBAP leadership met with BSP Monetary Board Member Romeo L. Bernardo to discuss key policy directions affecting rural banks and the path toward greater financial inclusion.",
    image: "https://rbap.org/wp-content/uploads/2026/09/bsp-meeting.jpg",
    fallbackBg: "from-green-600 to-green-800",
    href: "#",
  },
  {
    id: "news-2",
    category: "Workshop",
    categoryColor: "bg-blue-100 text-blue-700",
    date: "September 15, 2026",
    title: "Workshop on Shared Digital & Technology Infrastructure",
    excerpt: "RBAP conducted a comprehensive workshop empowering rural banks in the Philippines with shared digital and technology infrastructure solutions for the modern banking era.",
    image: "https://rbap.org/wp-content/uploads/2026/09/digital-workshop.jpg",
    fallbackBg: "from-blue-600 to-blue-800",
    href: "#",
  },
  {
    id: "news-3",
    category: "Community",
    categoryColor: "bg-red-100 text-red-700",
    date: "September 10, 2026",
    title: "Rural Banking Consciousness Week 2026 — Outreach at Philippine Red Cross",
    excerpt: "As part of Rural Banking Consciousness Week 2026, RBAP conducted an outreach program at the Philippine Red Cross Manila Chapter, bringing banking services closer to communities.",
    image: "https://rbap.org/wp-content/uploads/2026/09/outreach.jpg",
    fallbackBg: "from-red-600 to-red-800",
    href: "#",
  },
  {
    id: "news-4",
    category: "Partnership",
    categoryColor: "bg-purple-100 text-purple-700",
    date: "September 5, 2026",
    title: "Angel Network Roadshow for Visayas — Expanding Rural Investment",
    excerpt: "RBAP participated in the Angel Network Roadshow for Visayas, connecting rural banks with investment networks to expand capital access for small and medium enterprises.",
    image: "https://rbap.org/wp-content/uploads/2026/09/angel-network.jpg",
    fallbackBg: "from-purple-600 to-purple-800",
    href: "#",
  },
  {
    id: "news-5",
    category: "Meeting",
    categoryColor: "bg-yellow-100 text-yellow-700",
    date: "August 28, 2026",
    title: "Courtesy Meeting with Securities and Exchange Commission (SEC)",
    excerpt: "RBAP engaged with the Securities and Exchange Commission (SEC) to discuss regulatory alignment and opportunities for rural banks in capital market access.",
    image: "https://rbap.org/wp-content/uploads/2026/08/sec-meeting.jpg",
    fallbackBg: "from-yellow-600 to-yellow-800",
    href: "#",
  },
  {
    id: "news-6",
    category: "Training",
    categoryColor: "bg-teal-100 text-teal-700",
    date: "August 20, 2026",
    title: "BSP-RBAP Financial Literacy Training for Rural Bank Staff",
    excerpt: "A joint initiative between BSP and RBAP aimed at enhancing financial literacy and compliance standards among rural bank employees across the country.",
    image: "https://rbap.org/wp-content/uploads/2026/08/training.jpg",
    fallbackBg: "from-teal-600 to-teal-800",
    href: "#",
  },
];

const bgColors = [
  "from-green-600 to-green-800",
  "from-blue-600 to-blue-800",
  "from-red-600 to-red-800",
  "from-purple-600 to-purple-800",
  "from-yellow-600 to-yellow-800",
  "from-teal-600 to-teal-800",
];

const iconLetters = ["B", "W", "R", "A", "S", "T"];
---

<!-- News & Updates Section -->
<section class="py-16 bg-gray-50" id="news">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div>
        <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 rounded-full px-3 py-1 text-sm font-medium mb-3">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 002 2H4a2 2 0 01-2-2V5zm3 1h6v4H5V6zm6 6H5v2h6v-2z" clip-rule="evenodd"/>
            <path d="M15 7h1a2 2 0 012 2v5.5a1.5 1.5 0 01-3 0V7z"/>
          </svg>
          Latest Updates
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900">News & Events</h2>
        <p class="text-gray-500 mt-1 max-w-xl">Stay informed with the latest happenings in the rural banking sector and RBAP community.</p>
      </div>
      <a href="#" class="inline-flex items-center gap-2 text-green-700 font-semibold text-sm hover:text-green-800 hover:underline shrink-0">
        View all news
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <!-- Featured + Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Featured Article (Large) -->
      <article class="lg:col-span-1 lg:row-span-2 group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 flex flex-col">
        <div class={`h-64 bg-gradient-to-br ${bgColors[0]} relative overflow-hidden flex-shrink-0`}>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-20 h-20 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
              <span class="text-white font-bold text-3xl">{iconLetters[0]}</span>
            </div>
          </div>
          <div class="absolute top-4 left-4">
            <span class={`inline-block px-2.5 py-1 text-xs font-semibold rounded-full ${newsItems[0].categoryColor}`}>
              {newsItems[0].category}
            </span>
          </div>
          <!-- Hover overlay -->
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
        </div>
        <div class="p-6 flex flex-col flex-1">
          <div class="flex items-center gap-2 text-xs text-gray-400 mb-3">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
            </svg>
            {newsItems[0].date}
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-green-700 transition-colors leading-snug flex-1">
            {newsItems[0].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed mb-4">{newsItems[0].excerpt}</p>
          <a href={newsItems[0].href} class="inline-flex items-center gap-1.5 text-green-700 font-semibold text-sm hover:text-green-800 mt-auto">
            Read full story
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      </article>

      <!-- Remaining articles -->
      {newsItems.slice(1).map((item, i) => (
        <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 flex gap-0 sm:flex-row flex-col">
          <!-- Mini image -->
          <div class={`w-full sm:w-28 h-28 sm:h-auto bg-gradient-to-br ${bgColors[i + 1]} relative overflow-hidden flex-shrink-0 flex items-center justify-center`}>
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
              <span class="text-white font-bold text-lg">{iconLetters[i + 1]}</span>
            </div>
          </div>
          <div class="p-4 flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class={`inline-block px-2 py-0.5 text-xs font-semibold rounded-full ${item.categoryColor}`}>
                {item.category}
              </span>
              <span class="text-xs text-gray-400">{item.date}</span>
            </div>
            <h3 class="text-sm font-bold text-gray-900 mb-1.5 group-hover:text-green-700 transition-colors leading-snug line-clamp-2">
              {item.title}
            </h3>
            <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 mb-2">{item.excerpt}</p>
            <a href={item.href} class="inline-flex items-center gap-1 text-green-700 font-semibold text-xs hover:text-green-800 mt-auto">
              Read more
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- About RBAP Section -->
<section class="py-16 bg-white" id="about">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Visual -->
      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-green-700 to-green-900 p-8 lg:p-12 shadow-2xl">
          <!-- Pattern -->
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 200 200" class="w-full h-full">
              <defs>
                <pattern id="dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1.5" fill="white"/>
                </pattern>
              </defs>
              <rect width="200" height="200" fill="url(#dots)"/>
            </svg>
          </div>
          <!-- Decorative circles -->
          <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-green-500 opacity-20"></div>
          <div class="absolute -bottom-10 -left-10 w-32 h-32 rounded-full bg-green-300 opacity-20"></div>

          <div class="relative z-10">
            <div class="flex items-center gap-3 mb-8">
              <div class="w-16 h-16 rounded-full bg-white flex items-center justify-center shadow-lg">
                <span class="text-green-800 font-extrabold text-xl">RB</span>
              </div>
              <div>
                <div class="text-white font-bold text-lg leading-tight">Rural Bankers</div>
                <div class="text-green-200 text-sm">Association of the Philippines</div>
              </div>
            </div>

            <blockquote class="text-white text-xl font-semibold leading-relaxed mb-6">
              "Advancing rural banking for the economic progress and financial well-being of every Filipino."
            </blockquote>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">1955</div>
                <div class="text-green-200 text-sm">Year Founded</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">600+</div>
                <div class="text-green-200 text-sm">Member Banks</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">17</div>
                <div class="text-green-200 text-sm">Regional Chapters</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">3K+</div>
                <div class="text-green-200 text-sm">Banking Units</div>
              </div>
            </div>
          </div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -top-5 -right-5 bg-white rounded-2xl border border-gray-200 shadow-lg shadow-green-500/50 p-4 border border-gray-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-gray-900 text-sm">BSP Accredited</div>
              <div class="text-gray-500 text-xs">Official Banking Association</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div>
        <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 rounded-full px-3 py-1 text-sm font-medium mb-4">
          About RBAP
        </div>
        <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-5 leading-tight">
          The Voice of Rural Banking in the Philippines
        </h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Founded in 1955, the <strong>Rural Bankers Association of the Philippines (RBAP)</strong> is the official organization representing rural banks and cooperative banks across the archipelago. For over seven decades, we have championed the cause of rural banking as a catalyst for inclusive growth.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          RBAP works hand-in-hand with the Bangko Sentral ng Pilipinas (BSP), government agencies, and international partners to strengthen the rural banking system, expand financial access, and empower communities — from Luzon to Mindanao.
        </p>

        <!-- Key values -->
        <div class="space-y-3 mb-8">
          {[
            { icon: "🏦", title: "Financial Inclusion", desc: "Bringing banking services to unserved and underserved communities" },
            { icon: "📚", title: "Capacity Building", desc: "Training and education programs for rural bank professionals" },
            { icon: "🤝", title: "Advocacy & Representation", desc: "Voicing rural banking interests to regulators and policymakers" },
            { icon: "💻", title: "Digital Innovation", desc: "Leading technology adoption across the rural banking sector" },
          ].map((val) => (
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center text-lg flex-shrink-0">
                {val.icon}
              </div>
              <div>
                <div class="font-semibold text-gray-900 text-sm">{val.title}</div>
                <div class="text-gray-500 text-sm">{val.desc}</div>
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#" class="inline-flex items-center justify-center px-6 py-3 bg-green-700 text-white font-semibold rounded-lg hover:bg-green-800 transition-colors shadow-md hover:shadow-lg">
            Discover Our History
          </a>
          <a href="#" class="inline-flex items-center justify-center px-6 py-3 border-2 border-green-700 text-green-700 font-semibold rounded-lg hover:bg-green-50 transition-colors">
            Mission & Vision
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Programs & Services Section -->
<section class="py-16 bg-gray-50" id="programs">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 rounded-full px-3 py-1 text-sm font-medium mb-4">
        What We Offer
      </div>
      <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-4">Programs & Services</h2>
      <p class="text-gray-500 max-w-2xl mx-auto">RBAP provides a comprehensive suite of programs and services designed to strengthen rural banks and expand financial inclusion across the Philippines.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        {
          icon: "🎓",
          bg: "bg-green-50",
          iconBg: "bg-green-100",
          title: "Training & Education",
          desc: "Professional development programs, seminars, and e-learning modules designed to enhance the skills of rural bank professionals at all levels.",
          link: "View Training Programs",
        },
        {
          icon: "📱",
          bg: "bg-blue-50",
          iconBg: "bg-blue-100",
          title: "RBAP-MABS Program",
          desc: "The Microenterprise Access to Banking Services (MABS) program leverages mobile banking technology to bring financial services to micro-entrepreneurs.",
          link: "Learn About MABS",
        },
        {
          icon: "💡",
          bg: "bg-purple-50",
          iconBg: "bg-purple-100",
          title: "Technology & Innovation",
          desc: "Shared digital infrastructure, core banking solutions, and fintech partnerships that help rural banks compete in the digital economy.",
          link: "Explore Tech Solutions",
        },
        {
          icon: "📋",
          bg: "bg-orange-50",
          iconBg: "bg-orange-100",
          title: "Regulatory Compliance",
          desc: "Guidance, tools, and resources to help member banks navigate BSP regulations, AML compliance, and governance requirements.",
          link: "Compliance Resources",
        },
        {
          icon: "🌾",
          bg: "bg-yellow-50",
          iconBg: "bg-yellow-100",
          title: "Agricultural Finance",
          desc: "Programs supporting agri-lending, credit facilities for farmers and fisherfolk, and rural enterprise financing across the Philippines.",
          link: "Agricultural Programs",
        },
        {
          icon: "🤝",
          bg: "bg-teal-50",
          iconBg: "bg-teal-100",
          title: "Member Services",
          desc: "Group insurance, legal advisory, networking events, and exclusive benefits for RBAP member banks and their employees.",
          link: "Member Benefits",
        },
      ].map((service) => (
        <div class={`${service.bg} rounded-2xl p-6 border border-transparent hover:border-green-200 hover:shadow-md transition-all duration-300 group`}>
          <div class={`w-12 h-12 ${service.iconBg} rounded-xl flex items-center justify-center text-2xl mb-5`}>
            {service.icon}
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-green-700 transition-colors">
            {service.title}
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">{service.desc}</p>
          <a href="#" class="inline-flex items-center gap-1.5 text-green-700 font-semibold text-sm hover:text-green-800">
            {service.link}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Quick Links / Member Portal Banner -->
<section class="py-14 bg-gradient-to-r from-green-800 to-green-700" id="membership">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="text-center lg:text-left">
        <h2 class="text-3xl font-extrabold text-white mb-3">Join the RBAP Community</h2>
        <p class="text-green-100 max-w-xl">Become a member and gain access to exclusive programs, training, advocacy support, and a nationwide network of rural banking professionals.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 flex-shrink-0">
        <a href="#" class="inline-flex items-center justify-center px-7 py-3.5 bg-white text-green-800 font-bold rounded-xl hover:bg-green-50 transition-colors shadow-lg hover:shadow-xl text-sm">
          Apply for Membership
        </a>
        <a href="#" class="inline-flex items-center justify-center px-7 py-3.5 border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-colors text-sm">
          Member Login
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Partners & Accreditation -->
<section class="py-12 bg-white border-b border-gray-100">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <p class="text-center text-sm font-semibold text-gray-400 uppercase tracking-widest mb-8">Partners & Affiliations</p>
    <div class="flex flex-wrap items-center justify-center gap-8 lg:gap-16">
      {[
        { name: "Bangko Sentral ng Pilipinas", abbr: "BSP" },
        { name: "USAID Philippines", abbr: "USAID" },
        { name: "CARD MRI", abbr: "CARD" },
        { name: "LANDBANK", abbr: "LBP" },
        { name: "Philippine Deposit Insurance Corp.", abbr: "PDIC" },
        { name: "DA-ACPC", abbr: "ACPC" },
      ].map((partner) => (
        <div class="flex flex-col items-center gap-1 group cursor-pointer">
          <div class="w-16 h-16 rounded-2xl bg-gray-100 group-hover:bg-green-50 flex items-center justify-center transition-colors border border-gray-200 group-hover:border-green-200">
            <span class="text-xs font-bold text-gray-600 group-hover:text-green-700 transition-colors text-center leading-tight px-1">{partner.abbr}</span>
          </div>
          <span class="text-xs text-gray-400 text-center max-w-[80px] leading-tight">{partner.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>