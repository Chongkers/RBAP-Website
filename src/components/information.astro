---
const events = [
  {
    id: "event-1",
    category: "Annual Conference",
    categoryColor: "bg-green-100 text-green-800",
    date: "October 15, 2026",
    venue: "Manila Hotel, Ermita, Manila",
    title: "71st RBAP Annual National Convention",
    excerpt: "The flagship annual gathering of rural bankers across the Philippines — featuring keynote addresses from BSP officials, industry panels, and the election of RBAP officers.",
    status: "Open for Registration",
    statusColor: "bg-green-500",
    href: "#",
  },
  {
    id: "event-2",
    category: "Workshop",
    categoryColor: "bg-amber-100 text-amber-800",
    date: "October 22, 2026",
    venue: "RBAP Training Center, Quezon City",
    title: "Digital Banking & Core Banking System Workshop",
    excerpt: "Hands-on workshop for rural bank IT officers and management on shared digital infrastructure, core banking migration, and cybersecurity best practices.",
    status: "Limited Slots",
    statusColor: "bg-amber-500",
    href: "#",
  },
  {
    id: "event-3",
    category: "Seminar",
    categoryColor: "bg-stone-100 text-stone-700",
    date: "November 5, 2026",
    venue: "Davao City (Venue TBA)",
    title: "Mindanao Regional Chapter Assembly & Seminar",
    excerpt: "Mindanao-based rural banks convene for the regional chapter assembly, featuring updates on BSP regulations, agri-lending programs, and a financial literacy seminar.",
    status: "Coming Soon",
    statusColor: "bg-stone-400",
    href: "#",
  },
  {
    id: "event-4",
    category: "Training",
    categoryColor: "bg-green-100 text-green-800",
    date: "November 12, 2026",
    venue: "Online (Zoom Webinar)",
    title: "AML/CFT Compliance Training for Rural Banks",
    excerpt: "Mandatory compliance training covering Anti-Money Laundering and Counter-Terrorism Financing regulations, updated AMLC guidelines, and reporting requirements.",
    status: "Open for Registration",
    statusColor: "bg-green-500",
    href: "#",
  },
  {
    id: "event-5",
    category: "Forum",
    categoryColor: "bg-amber-100 text-amber-800",
    date: "November 20, 2026",
    venue: "Cebu City (Venue TBA)",
    title: "Visayas Rural Banking Forum & Expo",
    excerpt: "A regional forum showcasing rural banking innovations, financial inclusion programs, and investment opportunities in the Visayas island group.",
    status: "Coming Soon",
    statusColor: "bg-stone-400",
    href: "#",
  },
];

const bgColors = [
  "from-green-800 to-green-950",
  "from-amber-500 to-amber-700",
  "from-red-700 to-red-900",
  "from-green-700 to-green-900",
  "from-amber-600 to-amber-800",
];
---

<!-- Upcoming Events Section -->
<section class="py-16 bg-gray-50" id="events">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div>
        <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 rounded-full px-3 py-1 text-sm font-medium mb-3">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
          </svg>
          Calendar
        </div>
        <h2 class="text-3xl font-extrabold text-gray-900">Upcoming Events</h2>
        <p class="text-gray-500 mt-1 max-w-xl">Join RBAP at our upcoming conferences, workshops, seminars, and regional assemblies nationwide.</p>
      </div>
      <a href="#" class="inline-flex items-center gap-2 text-green-700 font-semibold text-sm hover:text-green-800 hover:underline shrink-0">
        View full calendar
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <!-- Events Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Featured Event (Large) -->
      <article class="lg:col-span-1 lg:row-span-2 group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 flex flex-col">
        <div class={`h-52 bg-gradient-to-br ${bgColors[0]} relative overflow-hidden flex-shrink-0`}>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center">
              <div class="text-white font-extrabold text-5xl leading-none">{events[0].date.split(' ')[1].replace(',','')}</div>
              <div class="text-green-200 text-sm font-medium mt-1">{events[0].date.split(' ')[0]} {events[0].date.split(' ')[2]}</div>
            </div>
          </div>
          <div class="absolute top-4 left-4 flex items-center gap-2">
            <span class={`inline-block px-2.5 py-1 text-xs font-semibold rounded-full ${events[0].categoryColor}`}>
              {events[0].category}
            </span>
          </div>
          <div class="absolute top-4 right-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-white">
              <span class={`w-2 h-2 rounded-full ${events[0].statusColor} animate-pulse`}></span>
              {events[0].status}
            </span>
          </div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
        </div>
        <div class="p-6 flex flex-col flex-1">
          <div class="flex items-center gap-2 text-xs text-gray-400 mb-3">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            {events[0].venue}
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-green-700 transition-colors leading-snug flex-1">
            {events[0].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed mb-4">{events[0].excerpt}</p>
          <a href={events[0].href} class="inline-flex items-center gap-1.5 text-green-700 font-semibold text-sm hover:text-green-800 mt-auto">
            Register Now
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      </article>

      <!-- Remaining events -->
      {events.slice(1).map((event, i) => (
        <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 flex sm:flex-row flex-col">
          <!-- Date badge -->
          <div class={`w-full sm:w-24 flex-shrink-0 bg-gradient-to-br ${bgColors[i + 1]} flex flex-col items-center justify-center p-3 min-h-[80px]`}>
            <div class="text-white font-extrabold text-2xl leading-none">{event.date.split(' ')[1].replace(',','')}</div>
            <div class="text-white/80 text-xs font-medium mt-0.5">{event.date.split(' ')[0]}</div>
            <div class="text-white/70 text-xs">{event.date.split(' ')[2]}</div>
          </div>
          <div class="p-4 flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class={`inline-block px-2 py-0.5 text-xs font-semibold rounded-full ${event.categoryColor}`}>
                {event.category}
              </span>
              <span class="inline-flex items-center gap-1 text-xs text-gray-400">
                <span class={`w-1.5 h-1.5 rounded-full ${event.statusColor}`}></span>
                {event.status}
              </span>
            </div>
            <h3 class="text-sm font-bold text-gray-900 mb-1.5 group-hover:text-green-700 transition-colors leading-snug line-clamp-2">
              {event.title}
            </h3>
            <div class="flex items-center gap-1 text-xs text-gray-400 mb-2">
              <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
              <span class="line-clamp-1">{event.venue}</span>
            </div>
            <a href={event.href} class="inline-flex items-center gap-1 text-green-700 font-semibold text-xs hover:text-green-800 mt-auto">
              View Details
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- About RBAP Section -->
<section class="py-16 bg-white" id="about">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Visual -->
      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-green-700 to-green-900 p-8 lg:p-12 shadow-2xl">
          <!-- Pattern -->
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 200 200" class="w-full h-full">
              <defs>
                <pattern id="dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1.5" fill="white"/>
                </pattern>
              </defs>
              <rect width="200" height="200" fill="url(#dots)"/>
            </svg>
          </div>
          <!-- Decorative circles -->
          <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-green-500 opacity-20"></div>
          <div class="absolute -bottom-10 -left-10 w-32 h-32 rounded-full bg-green-300 opacity-20"></div>

          <div class="relative z-10">
            <div class="flex items-center gap-3 mb-8">
              <div class="w-18 h-18 rounded-full object-cover bg-white flex items-center justify-center shadow-lg flex-shrink-0">
                <img
                  src="/rbap-icon.png"
                  alt="RBAP Logo"
                  class="w-12 h-30 object-contain"
                />
              </div>
              <div>
                <div class="text-white font-extrabold text-lg leading-tight">RBAP</div>
                <div class="text-green-200 text-xs leading-tight">Rural Bankers Association<br/>of the Philippines</div>
              </div>
            </div>

            <blockquote class="text-white text-xl font-semibold leading-relaxed mb-6">
              "Advancing rural banking for the economic progress and financial well-being of every Filipino."
            </blockquote>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">1955</div>
                <div class="text-green-200 text-sm">Year Founded</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">600+</div>
                <div class="text-green-200 text-sm">Member Banks</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">17</div>
                <div class="text-green-200 text-sm">Regional Chapters</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20">
                <div class="text-3xl font-extrabold text-white">3K+</div>
                <div class="text-green-200 text-sm">Banking Units</div>
              </div>
            </div>
          </div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -top-5 -right-5 bg-white rounded-2xl border border-gray-200 shadow-lg shadow-green-500/50 p-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-gray-900 text-sm">BSP Accredited</div>
              <div class="text-gray-500 text-xs">Official Banking Association</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div>
        <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 rounded-full px-3 py-1 text-sm font-medium mb-4">
          About RBAP
        </div>
        <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-5 leading-tight">
          The Voice of Rural Banking in the Philippines
        </h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Founded in 1955, the <strong>Rural Bankers Association of the Philippines (RBAP)</strong> is the official organization representing rural banks and cooperative banks across the archipelago. For over seven decades, we have championed the cause of rural banking as a catalyst for inclusive growth.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          RBAP works hand-in-hand with the Bangko Sentral ng Pilipinas (BSP), government agencies, and international partners to strengthen the rural banking system, expand financial access, and empower communities — from Luzon to Mindanao.
        </p>

        <!-- Key values -->
        <div class="space-y-3 mb-8">
          {[
            {
              title: "Financial Inclusion",
              desc: "Bringing banking services to unserved and underserved communities",
              svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" /></svg>`,
            },
            {
              title: "Capacity Building",
              desc: "Training and education programs for rural bank professionals",
              svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-1.372m0 0a50.536 50.536 0 0 1 3.741 1.372" /></svg>`,
            },
            {
              title: "Advocacy & Representation",
              desc: "Voicing rural banking interests to regulators and policymakers",
              svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 0 1-1.44-4.282m3.102.069a18.03 18.03 0 0 1-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 0 1 8.835 2.535M10.34 6.66a23.847 23.847 0 0 1 8.835-2.535m0 0A23.74 23.74 0 0 1 18.795 3m.38 1.125a23.91 23.91 0 0 1 1.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 0 0 1.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 0 1 0 3.46" /></svg>`,
            },
            {
              title: "Digital Innovation",
              desc: "Leading technology adoption across the rural banking sector",
              svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3" /></svg>`,
            },
          ].map((val) => (
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <span class="w-5 h-5 text-green-600 block" set:html={val.svg} />
              </div>
              <div>
                <div class="font-semibold text-gray-900 text-sm">{val.title}</div>
                <div class="text-gray-500 text-sm">{val.desc}</div>
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#" class="inline-flex items-center justify-center px-6 py-3 bg-green-700 text-white font-semibold rounded-lg hover:bg-green-800 transition-colors shadow-md hover:shadow-lg">
            Discover Our History
          </a>
          <a href="#" class="inline-flex items-center justify-center px-6 py-3 border-2 border-green-700 text-green-700 font-semibold rounded-lg hover:bg-green-50 transition-colors">
            Mission & Vision
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Programs & Services Section -->
<section class="py-16 bg-gray-50" id="programs">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 rounded-full px-3 py-1 text-sm font-medium mb-4">
        What We Offer
      </div>
      <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-4">Programs & Services</h2>
      <p class="text-gray-500 max-w-2xl mx-auto">RBAP provides a comprehensive suite of programs and services designed to strengthen rural banks and expand financial inclusion across the Philippines.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        {
          svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" /></svg>`,
          bg: "bg-green-50",
          iconBg: "bg-green-100",
          iconColor: "text-green-600",
          accent: "hover:border-green-300",
          title: "Microfinance Loans & Deposits",
          desc: "Accessible microfinance loan and deposit products tailored for micro-entrepreneurs and low-income households in rural communities.",
          link: "Read more",
          href: "https://rbap.org/programs/rb-products-and-services/microfinance-loans-and-deposits/",
        },
        {
          svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>`,
          bg: "bg-blue-50",
          iconBg: "bg-blue-100",
          iconColor: "text-blue-600",
          accent: "hover:border-blue-300",
          title: "Salary Loans",
          desc: "Convenient salary loan facilities for employees through accredited rural banks, offering competitive rates and flexible repayment terms.",
          link: "Read more",
          href: "https://rbap.org/programs/rb-products-and-services/salary-loans/",
        },
        {
          svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>`,
          bg: "bg-yellow-50",
          iconBg: "bg-yellow-100",
          iconColor: "text-yellow-600",
          accent: "hover:border-yellow-300",
          title: "Agricultural Loans",
          desc: "Dedicated credit programs for farmers, fisherfolk, and agri-based enterprises — supporting food security and rural livelihood development.",
          link: "Read more",
          href: "https://rbap.org/programs/rb-products-and-services/agricultural-loans/",
        },
        {
