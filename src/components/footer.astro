---
const footerLinks = {
  "About RBAP": [
    { label: "History", href: "#" },
    { label: "Mission & Vision", href: "#" },
    { label: "Board of Directors", href: "#" },
    { label: "Organizational Chart", href: "#" },
    { label: "Annual Reports", href: "#" },
  ],
  "Programs & Services": [
    { label: "Training & Education", href: "#" },
    { label: "RBAP-MABS Program", href: "#" },
    { label: "Technology Solutions", href: "#" },
    { label: "Agricultural Finance", href: "#" },
    { label: "Member Services", href: "#" },
  ],
  "Resources": [
    { label: "News & Events", href: "#" },
    { label: "Publications", href: "#" },
    { label: "Circulars & Advisories", href: "#" },
    { label: "Forms & Downloads", href: "#" },
    { label: "Photo Gallery", href: "#" },
  ],
  "Membership": [
    { label: "Membership Benefits", href: "#" },
    { label: "Apply for Membership", href: "#" },
    { label: "Member Directory", href: "#" },
    { label: "Locate a Bank", href: "/locate-a-bank" },
    { label: "Member Login", href: "#" },
  ],
};
---

<footer class="bg-green-900 text-white">
  <!-- Main Footer -->
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6 pt-14 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 mb-10">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 mb-5 group w-fit">
          <img
            src="/rbap-icon.png"
            alt="RBAP Logo"
            class="h-12 w-12 object-contain opacity-95 group-hover:opacity-100 transition-opacity"
          />
          <div class="leading-tight">
            <div class="font-extrabold text-white text-base tracking-tight">Rural Bankers Association</div>
            <div class="text-green-300 text-xs">of the Philippines</div>
          </div>
        </a>

        <p class="text-green-200 text-sm leading-relaxed mb-5">
          Empowering rural banks and communities across the Philippines since 1955.
        </p>

        <!-- Contact Info -->
        <div class="space-y-2.5 text-sm text-green-200">
          <div class="flex items-start gap-2">
            <svg class="w-4 h-4 text-green-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            <span>2/F RBAP Bldg., A. Soriano Jr. Ave. cor. Arzobispo St., Intramuros, Manila</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <a href="tel:+6328921-4184" class="hover:text-white transition-colors">(02) 8921-4184 to 85</a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
            <a href="https://mail.rbap.org/" target="_blank" rel="noopener" class="hover:text-white transition-colors">mail.rbap.org</a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16A8 8 0 0010 2zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.559-.499-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.559.499.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"/>
            </svg>
            <a href="https://www.rbap.org" target="_blank" rel="noopener" class="hover:text-white transition-colors">www.rbap.org</a>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex items-center gap-2.5 mt-6">
          <a href="https://www.facebook.com/ruralbankersph" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-green-800 hover:bg-green-600 border border-green-700 flex items-center justify-center transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/></svg>
          </a>
          <a href="https://www.youtube.com/@rbapcommunicationsspecialist/videos" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-green-800 hover:bg-green-600 border border-green-700 flex items-center justify-center transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd"/></svg>
          </a>
          <a href="https://mail.rbap.org/" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-green-800 hover:bg-green-600 border border-green-700 flex items-center justify-center transition-colors" aria-label="Email">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(footerLinks).map(([category, links]) => (
        <div>
          <h3 class="text-xs font-bold text-green-300 uppercase tracking-widest mb-4">{category}</h3>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-green-200 hover:text-white transition-colors flex items-center gap-1.5 group">
                  <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Newsletter Banner -->
    <div class="bg-green-800/50 border border-green-700/60 rounded-2xl p-6 mb-8">
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <div class="flex-1 text-center sm:text-left">
          <h4 class="font-bold text-white mb-1">Stay Updated with RBAP</h4>
          <p class="text-green-300 text-sm">Subscribe to our newsletter for the latest news, events, and circulars.</p>
        </div>
        <form class="flex gap-2 w-full sm:w-auto" action="#" method="post">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 sm:w-60 px-4 py-2.5 rounded-lg bg-green-900/60 border border-green-600 text-white placeholder-green-400 focus:outline-none focus:border-white text-sm"
            required
          />
          <button type="submit" class="px-5 py-2.5 bg-white text-green-800 font-bold rounded-lg hover:bg-green-50 transition-colors text-sm whitespace-nowrap">
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-green-700/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-green-400">
      <span>© {new Date().getFullYear()} Rural Bankers Association of the Philippines. All Rights Reserved.</span>
      <div class="flex items-center gap-4">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <span class="text-green-700">•</span>
        <a href="#" class="hover:text-white transition-colors">Terms & Conditions</a>
        <span class="text-green-700">•</span>
        <a href="#" class="hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>