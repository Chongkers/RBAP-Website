---
const footerLinks = {
  "About RBAP": [
    { label: "History", href: "#" },
    { label: "Mission & Vision", href: "#" },
    { label: "Board of Directors", href: "#" },
    { label: "Organizational Chart", href: "#" },
    { label: "Annual Reports", href: "#" },
  ],
  "Programs & Services": [
    { label: "Training & Education", href: "#" },
    { label: "RBAP-MABS Program", href: "#" },
    { label: "Technology Solutions", href: "#" },
    { label: "Agricultural Finance", href: "#" },
    { label: "Member Services", href: "#" },
  ],
  "Resources": [
    { label: "News & Events", href: "#" },
    { label: "Publications", href: "#" },
    { label: "Circulars & Advisories", href: "#" },
    { label: "Forms & Downloads", href: "#" },
    { label: "Photo Gallery", href: "#" },
  ],
  "Membership": [
    { label: "Membership Benefits", href: "#" },
    { label: "Apply for Membership", href: "#" },
    { label: "Member Directory", href: "#" },
    { label: "Member Login", href: "#" },
  ],
};
---

<footer class="bg-gray-900 text-white">
  <!-- Main Footer -->
  <div class="max-w-screen-xl mx-auto px-4 lg:px-6 pt-14 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 mb-10">
      <!-- Brand column -->
      <div class="lg:col-span-1">
        <!-- Logo -->
        <div class="flex items-center gap-3 mb-5">
          <div class="w-12 h-12 rounded-full bg-green-600 flex items-center justify-center font-bold text-lg shadow-md">
            RB
          </div>
          <div>
            <div class="font-bold text-white text-sm leading-tight">Rural Bankers Association</div>
            <div class="text-green-400 text-xs">of the Philippines</div>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-5">
          Empowering rural banks and communities across the Philippines since 1955.
        </p>
        <!-- Contact Info -->
        <div class="space-y-2 text-sm text-gray-400">
          <div class="flex items-start gap-2">
            <svg class="w-4 h-4 text-green-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            <span>RBAP Bldg., A. Soriano Ave., Intramuros, Manila</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <a href="tel:+6328921-4184" class="hover:text-green-400 transition-colors">(02) 8921-4184 to 85</a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
            <a href="mailto:rbap@rbap.org" class="hover:text-green-400 transition-colors">rbap@rbap.org</a>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex items-center gap-3 mt-6">
          <a href="https://www.facebook.com/rbapofficial" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-gray-800 hover:bg-green-700 flex items-center justify-center transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-gray-800 hover:bg-green-700 flex items-center justify-center transition-colors" aria-label="Twitter/X">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-gray-800 hover:bg-green-700 flex items-center justify-center transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg bg-gray-800 hover:bg-green-700 flex items-center justify-center transition-colors" aria-label="LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(footerLinks).map(([category, links]) => (
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{category}</h3>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-gray-400 hover:text-green-400 transition-colors flex items-center gap-1.5 group">
                  <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Newsletter Banner -->
    <div class="bg-green-800/30 border border-green-700/40 rounded-2xl p-6 mb-8">
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <div class="flex-1 text-center sm:text-left">
          <h4 class="font-bold text-white mb-1">Stay Updated with RBAP</h4>
          <p class="text-green-300 text-sm">Subscribe to our newsletter for the latest news, events, and circulars.</p>
        </div>
        <form class="flex gap-2 w-full sm:w-auto" action="#" method="post">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 sm:w-64 px-4 py-2.5 rounded-lg bg-gray-800 border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-green-500 text-sm"
            required
          />
          <button type="submit" class="px-5 py-2.5 bg-green-600 hover:bg-green-500 text-white font-semibold rounded-lg transition-colors text-sm whitespace-nowrap">
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
      <span>© {new Date().getFullYear()} Rural Bankers Association of the Philippines. All Rights Reserved.</span>
      <div class="flex items-center gap-4">
        <a href="#" class="hover:text-green-400 transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="#" class="hover:text-green-400 transition-colors">Terms & Conditions</a>
        <span>•</span>
        <a href="#" class="hover:text-green-400 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>