---
const slides = [
  {
    id: "slide-1",
    title: "Empowering Rural Banks Across the Philippines",
    subtitle: "Building Financial Inclusion in Every Community",
    description:
      "The Rural Bankers Association of the Philippines (RBAP) has been the voice and champion of rural banking since 1955, driving economic growth and financial inclusion in underserved communities.",
    cta: { label: "Learn More About RBAP", href: "#about" },
    cta2: { label: "Become a Member", href: "#membership" },
    bg: "from-green-900 via-green-800 to-green-700",
  },
  {
    id: "slide-2",
    title: "Rural Banking Consciousness Week 2026",
    subtitle: "Celebrating 71 Years of Service",
    description:
      "Join us as we celebrate Rural Banking Consciousness Week 2026 — uniting rural banks, cooperatives, and communities across the Philippines for a stronger financial future.",
    cta: { label: "View Events", href: "#events" },
    cta2: { label: "Read More", href: "#news" },
    bg: "from-blue-900 via-green-900 to-green-800",
  },
  {
    id: "slide-3",
    title: "Digital Transformation for Rural Banks",
    subtitle: "Technology & Shared Infrastructure Workshop",
    description:
      "RBAP is leading the charge on digital innovation — helping rural and cooperative banks adopt shared technology infrastructure to better serve Filipinos wherever they are.",
    cta: { label: "Explore Programs", href: "#programs" },
    cta2: { label: "Contact Us", href: "#contact" },
    bg: "from-green-900 via-teal-900 to-green-800",
  },
];
---

<section id="hero-carousel" data-carousel="slide">
  <!-- ── Carousel wrapper: slides + nav/dots all live here ── -->
  <div class="relative h-[500px] sm:h-[560px] overflow-hidden" data-carousel-wrapper>

    <!-- Slides -->
    {slides.map((slide, index) => (
      <div
        class={`absolute inset-0 duration-700 ease-in-out transition-opacity ${index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"} bg-gradient-to-br ${slide.bg}`}
        data-carousel-item
        id={slide.id}
      >
        <!-- Background grid pattern -->
        <div class="absolute inset-0 opacity-10">
          <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs>
              <pattern id={`grid-${index}`} width="10" height="10" patternUnits="userSpaceOnUse">
                <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
              </pattern>
            </defs>
            <rect width="100" height="100" fill={`url(#grid-${index})`}/>
          </svg>
        </div>

        <!-- Decorative circles -->
        <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-white opacity-5"></div>
        <div class="absolute -bottom-10 -left-10 w-60 h-60 rounded-full bg-white opacity-5"></div>
        <div class="absolute top-1/2 right-1/4 w-40 h-40 rounded-full bg-green-400 opacity-10"></div>

        <!-- Slide content -->
        <div class="relative z-10 flex items-center h-full max-w-screen-xl mx-auto px-6 lg:px-8">
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm rounded-full px-4 py-1.5 mb-6">
              <div class="w-2 h-2 rounded-full bg-green-300 animate-pulse"></div>
              <span class="text-green-100 text-sm font-medium">{slide.subtitle}</span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6 drop-shadow-lg">
              {slide.title}
            </h1>
            <p class="text-lg text-green-100 mb-8 max-w-2xl leading-relaxed">
              {slide.description}
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={slide.cta.href}
                class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-green-900 bg-white rounded-lg hover:bg-green-50 transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5 transform"
              >
                {slide.cta.label}
                <svg class="w-4 h-4 ml-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </a>
              <a
                href={slide.cta2.href}
                class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white border-2 border-white/60 rounded-lg hover:bg-white/10 hover:border-white transition-all duration-200"
              >
                {slide.cta2.label}
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}

    <!-- Prev button — absolute inside wrapper = centered in slide area -->
    <button
      type="button"
      class="absolute left-4 top-1/2 -translate-y-1/2 z-20 flex items-center justify-center w-10 h-10 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-all duration-200"
      id="hero-prev"
      aria-label="Previous slide"
    >
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <!-- Next button -->
    <button
      type="button"
      class="absolute right-4 top-1/2 -translate-y-1/2 z-20 flex items-center justify-center w-10 h-10 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-all duration-200"
      id="hero-next"
      aria-label="Next slide"
    >
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Dots — bottom-6 inside wrapper = well above the slide's lower edge, nowhere near stats bar -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex gap-2">
      {slides.map((_, i) => (
        <button
          type="button"
          class={`h-2.5 rounded-full transition-all duration-300 carousel-dot ${i === 0 ? "bg-white w-7" : "w-2.5 bg-white/50 hover:bg-white/80"}`}
          data-index={i}
          aria-label={`Go to slide ${i + 1}`}
        />
      ))}
    </div>

  </div>
  <!-- ── End carousel wrapper ── -->

  <!-- Stats bar — normal-flow block, rendered AFTER the wrapper, completely separate -->
  <div class="bg-green-950 border-t border-white/10">
    <div class="max-w-screen-xl mx-auto px-5 py-4 grid grid-cols-3 gap-4 text-center">
      <div>
        <div class="text-white font-bold text-xl">600+</div>
        <div class="text-green-400 text-xs">Member Rural Banks</div>
      </div>
      <div class="border-x border-white/10">
        <div class="text-white font-bold text-xl">71 Years</div>
        <div class="text-green-400 text-xs">of Service to Filipinos</div>
      </div>
      <div>
        <div class="text-white font-bold text-xl">17 Regions</div>
        <div class="text-green-400 text-xs">Nationwide Coverage</div>
      </div>
    </div>
  </div>
</section>

<script>
  const wrapper = document.querySelector('[data-carousel-wrapper]');
  const items = wrapper?.querySelectorAll('[data-carousel-item]');
  const dots = document.querySelectorAll('.carousel-dot');
  const prevBtn = document.getElementById('hero-prev');
  const nextBtn = document.getElementById('hero-next');

  let current = 0;
  let autoplayTimer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    if (!items) return;
    items[current].classList.remove('opacity-100', 'z-10');
    items[current].classList.add('opacity-0', 'z-0');
    dots[current]?.classList.remove('bg-white', 'w-7');
    dots[current]?.classList.add('w-2.5', 'bg-white/50');

    current = (index + items.length) % items.length;

    items[current].classList.remove('opacity-0', 'z-0');
    items[current].classList.add('opacity-100', 'z-10');
    dots[current]?.classList.add('bg-white', 'w-7');
    dots[current]?.classList.remove('w-2.5', 'bg-white/50');
  }

  function startAutoplay() {
    autoplayTimer = setInterval(() => goTo(current + 1), 5000);
  }
  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  prevBtn?.addEventListener('click', () => { goTo(current - 1); resetAutoplay(); });
  nextBtn?.addEventListener('click', () => { goTo(current + 1); resetAutoplay(); });
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { goTo(i); resetAutoplay(); });
  });

  startAutoplay();
</script>