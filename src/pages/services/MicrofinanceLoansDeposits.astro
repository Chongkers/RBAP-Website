---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/footer.astro";
---

<Layout
  title="Microfinance Loans & Deposits — RBAP"
  description="RBAP member rural banks offer microfinance loan and deposit products tailored for micro-entrepreneurs and low-income households in rural communities across the Philippines."
>
  <Navbar />
  <main>

    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-green-900 via-green-800 to-emerald-800 pt-20 pb-28">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="max-w-screen-xl mx-auto px-6 lg:px-8 relative z-10">
        <nav class="flex items-center gap-2 text-green-300 text-sm mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
          <span class="text-green-400">Programs & Services</span>
          <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
          <span class="text-white font-medium">Microfinance Loans & Deposits</span>
        </nav>
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 mb-5">
          <div class="w-2 h-2 rounded-full bg-green-300 animate-pulse"></div>
          <span class="text-green-100 text-sm font-medium tracking-wide">RB Products & Services</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-5 drop-shadow-lg">
          Microfinance Loans<br class="hidden sm:block" /> & Deposits
        </h1>
        <p class="text-lg text-green-100 max-w-2xl leading-relaxed">
          Empowering micro-entrepreneurs and low-income Filipinos with accessible credit and savings products through RBAP's network of rural banks.
        </p>
      </div>
      <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none">
        <svg class="relative block w-full h-12 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 48" preserveAspectRatio="none">
          <path fill="currentColor" d="M0,48 C360,0 1080,0 1440,48 L1440,48 L0,48 Z"/>
        </svg>
      </div>
    </section>

    <!-- Content -->
    <section class="py-20 bg-white">
      <div class="max-w-screen-xl mx-auto px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-12">

          <!-- Main content -->
          <div class="lg:col-span-2 space-y-8">
            <div>
              <h2 class="text-2xl font-extrabold text-gray-900 mb-4">What is Microfinance?</h2>
              <p class="text-gray-600 leading-relaxed mb-4">
                Microfinance refers to a range of financial services — including small loans, savings, and micro-insurance — offered to individuals and small businesses that lack access to conventional banking. RBAP member rural banks are at the forefront of delivering these services to the unbanked and underbanked communities throughout the Philippine countryside.
              </p>
              <p class="text-gray-600 leading-relaxed">
                Through the RBAP-MABS (Microenterprise Access to Banking Services) program and other microfinance initiatives, rural banks provide Filipinos with the tools they need to grow their livelihoods, build financial resilience, and achieve economic independence.
              </p>
            </div>

            <div>
              <h2 class="text-2xl font-extrabold text-gray-900 mb-4">Microfinance Loan Features</h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {[
                  { title: "Small Loan Amounts", desc: "Loans designed for micro-scale needs — from PHP 5,000 to PHP 150,000 — accessible to market vendors, sari-sari store owners, and small-scale farmers." },
                  { title: "Flexible Repayment", desc: "Weekly, bi-weekly, or monthly repayment schedules that align with the income cycles of micro-entrepreneurs." },
                  { title: "No Collateral Required", desc: "Group lending methodologies and character-based lending reduce collateral barriers for borrowers who lack formal assets." },
                  { title: "Fast Processing", desc: "Streamlined loan evaluation process with quick turnaround, allowing clients to access funds when they need them most." },
                ].map(f => (
                  <div class="bg-green-50 border border-green-100 rounded-xl p-5">
                    <h3 class="font-bold text-gray-900 mb-1">{f.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <h2 class="text-2xl font-extrabold text-gray-900 mb-4">Deposit Products</h2>
              <p class="text-gray-600 leading-relaxed mb-4">
                Alongside credit, RBAP member rural banks offer microfinance-linked deposit products that encourage a savings culture among low-income clients:
              </p>
              <ul class="space-y-3">
                {[
                  "Microsavings accounts with low or no minimum maintaining balance",
                  "Passbook and ATM-linked savings options",
                  "Time deposit products with competitive interest rates",
                  "Compulsory savings linked to microfinance loan products",
                ].map(item => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1 w-5 h-5 rounded-full bg-green-100 flex items-center justify-center shrink-0">
                      <svg class="w-3 h-3 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="space-y-6">
            <div class="bg-green-800 rounded-2xl p-6 text-white">
              <h3 class="font-extrabold text-lg mb-3">Quick Facts</h3>
              <div class="space-y-3 text-sm">
                {[
                  { label: "Loan Range", value: "PHP 5K – PHP 150K" },
                  { label: "Target Clients", value: "Micro-entrepreneurs & farmers" },
                  { label: "Collateral", value: "Often not required" },
                  { label: "Regulated by", value: "Bangko Sentral ng Pilipinas" },
                ].map(f => (
                  <div class="flex justify-between border-b border-white/20 pb-3">
                    <span class="text-green-200">{f.label}</span>
                    <span class="font-semibold text-right">{f.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
              <h3 class="font-extrabold text-gray-900 mb-3">Other Services</h3>
              <ul class="space-y-2">
                {[
                  { label: "Salary Loans", href: "/services/SalaryLoans" },
                  { label: "Agricultural Loans", href: "/services/AgriculturalLoans" },
                  { label: "Deposit Services", href: "/services/DepositServices" },
                  { label: "Payment of Bills", href: "/services/PaymentofBills" },
                  { label: "Remittances", href: "/services/Remittances" },
                ].map(s => (
                  <li>
                    <a href={s.href} class="flex items-center gap-2 text-sm text-gray-700 hover:text-green-700 font-medium transition-colors">
                      <svg class="w-3.5 h-3.5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-green-800 to-green-900 py-14">
      <div class="max-w-screen-xl mx-auto px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold text-white mb-1">Find a Rural Bank Near You</h2>
          <p class="text-green-200 text-sm">Locate an RBAP member bank that offers microfinance services in your area.</p>
        </div>
        <a href="/locate-a-bank" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-green-800 font-semibold rounded-lg hover:bg-green-50 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-sm shrink-0">
          Locate a Bank
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .blob { position: absolute; border-radius: 9999px; pointer-events: none; }
  .blob-1 { width: 28rem; height: 28rem; top: -6rem; right: -6rem; background: white; opacity: 0.03; }
  .blob-2 { width: 20rem; height: 20rem; bottom: 2rem; left: -4rem; background: #4ade80; opacity: 0.07; }
</style>
