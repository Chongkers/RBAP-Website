      { no: 12, name: "Federation of Batangas Rural Bankers",                                         president: "Enrique Jose C. Estrada",              ruralBank: "Summit Rural Bank of Lipa City, Inc.",                                contact: "043-7572513 ; 043-4036499 ; 09171624490" },
      { no: 13, name: "Federation of Laguna Rural Bankers",                                           president: "Almira Resureccion",                   ruralBank: "Rural Bank of Bay, Inc.",                                             contact: "(049) 536-0013" },
      { no: 14, name: "Quezon Federation of Rural Bankers",                                           president: "Jose Paolo M. Palileo",                ruralBank: "Bayanihan Bank, Inc. - formerly Rural Bank of Atimonan, Inc.",         contact: "042-316-5337 ; 09199131539" },
