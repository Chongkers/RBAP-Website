---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/footer.astro";

const coreValues = [
  {
    id: "resilience",
    title: "Resilience",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.955 11.955 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
    description:
      "RBAP recognizes the challenges faced by rural banks and the communities they serve. Its members are resilient in the face of adversity, adaptable to change, and proactive in finding solutions to diverse issues.",
    gradient: "from-emerald-500 to-green-600",
    bg: "bg-emerald-50",
    border: "border-emerald-200",
    text: "text-emerald-700",
  },
  {
    id: "balance",
    title: "Balance",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z" /></svg>`,
    description:
      "RBAP embraces a harmonious balance between personal and professional lives. It tempers the pursuit of economic gains with due attention to social and environmental consideration.",
    gradient: "from-teal-500 to-cyan-600",
    bg: "bg-teal-50",
    border: "border-teal-200",
    text: "text-teal-700",
  },
  {
    id: "accountability",
    title: "Accountability",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>`,
    description:
      "RBAP emphasizes individual and collective accountability. It subscribes to the principle that accountability is the cornerstone of a high-performing team.",
    gradient: "from-green-600 to-lime-600",
    bg: "bg-green-50",
    border: "border-green-200",
    text: "text-green-700",
  },
  {
    id: "professionalism",
    title: "Professionalism",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>`,
    description:
      "RBAP puts on a professionalism that encompasses such qualities as integrity, ethical behavior and commitment to excellence.",
    gradient: "from-green-700 to-emerald-700",
    bg: "bg-lime-50",
    border: "border-lime-200",
    text: "text-lime-700",
  },
];
---

<Layout
  title="Mission, Vision & Core Values — Rural Bankers Association of the Philippines"
  description="Learn about RBAP's vision to be the most trusted association in the Philippines, its mission to champion rural banks, and the core values of Resilience, Balance, Accountability, and Professionalism."
>
  <Navbar />
  <main>

    <!-- ── Page Hero ── -->
    <section class="relative overflow-hidden bg-gradient-to-br from-green-900 via-green-800 to-emerald-800 pt-20 pb-28">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>

      <div class="max-w-screen-xl mx-auto px-6 lg:px-8 relative z-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-green-300 text-sm mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
          <span class="text-green-400">About RBAP</span>
          <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
          <span class="text-white font-medium">Mission &amp; Vision</span>
        </nav>

        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 mb-5">
          <div class="w-2 h-2 rounded-full bg-green-300 animate-pulse"></div>
          <span class="text-green-100 text-sm font-medium tracking-wide">About RBAP</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-5 drop-shadow-lg">
          Mission, Vision &amp;<br class="hidden sm:block" />
          Core Values
        </h1>
        <p class="text-lg text-green-100 max-w-2xl leading-relaxed">
          The guiding principles and aspirations that drive the Rural Bankers Association of the Philippines in championing rural banking and financial inclusion across the country.
        </p>
      </div>

      <!-- Wave divider -->
      <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none">
        <svg class="relative block w-full h-12 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 48" preserveAspectRatio="none">
          <path fill="currentColor" d="M0,48 C360,0 1080,0 1440,48 L1440,48 L0,48 Z"/>
        </svg>
      </div>
    </section>

    <!-- ── Vision & Mission ── -->
    <section class="py-20 bg-white" id="vision-mission">
      <div class="max-w-screen-xl mx-auto px-6 lg:px-8">

        <div class="text-center mb-14 fade-in">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-green-600 bg-green-50 border border-green-100 px-4 py-1.5 rounded-full mb-4">Who We Are</span>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-3">Our Direction &amp; Purpose</h2>
          <p class="text-gray-500 max-w-xl mx-auto">A clear mission and an ambitious vision guide everything RBAP does for rural banks and their communities.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

          <!-- Vision Card -->
          <div id="vision-card" class="group relative rounded-2xl overflow-hidden shadow-md border border-green-100 hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5 fade-in">
            <!-- hover overlay -->
            <div class="absolute inset-0 bg-gradient-to-br from-green-700 to-green-900 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            <!-- decorative circle -->
            <div class="absolute top-0 right-0 w-52 h-52 rounded-full bg-green-50 group-hover:bg-white/10 -translate-y-1/2 translate-x-1/2 transition-colors duration-500 pointer-events-none"></div>

            <div class="relative z-10 p-8 lg:p-10">
              <div class="w-14 h-14 rounded-xl bg-green-100 group-hover:bg-white/20 flex items-center justify-center mb-6 transition-colors duration-500 shadow-sm">
                <svg class="w-7 h-7 text-green-700 group-hover:text-white transition-colors duration-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
              </div>

              <span class="inline-block text-xs font-bold uppercase tracking-widest text-green-600 group-hover:text-green-200 bg-green-50 group-hover:bg-white/10 border border-green-100 group-hover:border-white/20 px-3 py-1 rounded-full mb-4 transition-all duration-500">Our Vision</span>
              <h2 class="text-2xl lg:text-3xl font-extrabold text-gray-900 group-hover:text-white mb-4 transition-colors duration-500 leading-snug">
                Trusted. Empowering.<br />Nationwide.
              </h2>
              <p class="text-gray-600 group-hover:text-green-50 text-base lg:text-lg leading-relaxed transition-colors duration-500">
                To be the most trusted Association in the Philippines empowering Rural Banks in delivering responsive financial products and services to the countryside.
              </p>
            </div>
          </div>

          <!-- Mission Card -->
          <div id="mission-card" class="group relative rounded-2xl overflow-hidden shadow-md border border-emerald-100 hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5 fade-in fade-delay-1">
            <!-- hover overlay -->
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-700 to-green-900 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            <!-- decorative circle -->
            <div class="absolute top-0 right-0 w-52 h-52 rounded-full bg-emerald-50 group-hover:bg-white/10 -translate-y-1/2 translate-x-1/2 transition-colors duration-500 pointer-events-none"></div>

            <div class="relative z-10 p-8 lg:p-10">
              <div class="w-14 h-14 rounded-xl bg-emerald-100 group-hover:bg-white/20 flex items-center justify-center mb-6 transition-colors duration-500 shadow-sm">
                <svg class="w-7 h-7 text-emerald-700 group-hover:text-white transition-colors duration-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
                </svg>
              </div>

              <span class="inline-block text-xs font-bold uppercase tracking-widest text-emerald-600 group-hover:text-emerald-200 bg-emerald-50 group-hover:bg-white/10 border border-emerald-100 group-hover:border-white/20 px-3 py-1 rounded-full mb-4 transition-all duration-500">Our Mission</span>
              <h2 class="text-2xl lg:text-3xl font-extrabold text-gray-900 group-hover:text-white mb-4 transition-colors duration-500 leading-snug">
                Champions of<br />Rural Banking
              </h2>
              <div class="space-y-3">
                <p class="text-gray-600 group-hover:text-green-50 text-base leading-relaxed transition-colors duration-500">
                  We Champion the interests of member banks, promote their development and enhance their capacity to serve the needs of rural communities.
                </p>
                <p class="text-gray-600 group-hover:text-green-100 text-base leading-relaxed transition-colors duration-500">
                  We equip our members with the necessary tools, knowledge and support system to excel in their operations while advocating for policies that promote financial inclusion, economic growth and stability.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── Core Values ── -->
    <section class="py-20 bg-gray-50" id="core-values">
      <div class="max-w-screen-xl mx-auto px-6 lg:px-8">

        <div class="text-center mb-14 fade-in">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-green-600 bg-green-50 border border-green-100 px-4 py-1.5 rounded-full mb-4">Core Values</span>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-3">The Values That Guide Us</h2>
          <p class="text-gray-500 max-w-2xl mx-auto text-base lg:text-lg">
            These four core values are the foundation of RBAP's culture — shaping how its members operate, collaborate, and serve rural communities across the Philippines.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {coreValues.map((value, index) => (
            <div
              id={`value-${value.id}`}
              class={`value-card group relative rounded-2xl border ${value.border} ${value.bg} p-7 hover:shadow-xl transition-all duration-500 hover:-translate-y-2 overflow-hidden cursor-default`}
            >
              <!-- Top gradient bar -->
              <div class={`absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r ${value.gradient} rounded-t-2xl`}></div>

              <!-- Ghost number -->
              <div class="absolute top-3 right-4 text-6xl font-black text-black/[0.04] group-hover:text-black/[0.07] transition-colors duration-300 select-none leading-none pointer-events-none">
                {String(index + 1).padStart(2, '0')}
              </div>

              <!-- Icon -->
              <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${value.gradient} flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300 shadow-md`}>
                <span class="w-6 h-6 text-white block" set:html={value.icon} />
              </div>

              <h3 class={`text-lg font-bold ${value.text} mb-3 group-hover:translate-x-0.5 transition-transform duration-300`}>
                {value.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                {value.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CTA Strip ── -->
    <section class="bg-gradient-to-r from-green-800 to-green-900 py-14">
      <div class="max-w-screen-xl mx-auto px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold text-white mb-1">Ready to be part of RBAP?</h2>
          <p class="text-green-200 text-sm">Join hundreds of rural banks championing financial inclusion across the Philippines.</p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a href="#" id="cta-membership" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-green-800 font-semibold rounded-lg hover:bg-green-50 transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-sm">
            Become a Member
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="/" id="cta-home" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-white/50 text-white font-semibold rounded-lg hover:bg-white/10 hover:border-white transition-all duration-200 text-sm">
            Back to Home
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* Blob decorations */
  .blob {
    position: absolute;
    border-radius: 9999px;
    pointer-events: none;
  }
  .blob-1 {
    width: 28rem; height: 28rem;
    top: -6rem; right: -6rem;
    background: white;
    opacity: 0.03;
  }
  .blob-2 {
    width: 20rem; height: 20rem;
    bottom: 2rem; left: -4rem;
    background: #4ade80;
    opacity: 0.07;
  }
  .blob-3 {
    width: 14rem; height: 14rem;
    top: 50%; left: 35%;
    background: white;
    opacity: 0.04;
  }

  /* Scroll-reveal */
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s ease forwards;
  }
  .fade-delay-1 { animation-delay: 150ms; }

  .value-card {
    opacity: 0;
    transform: translateY(24px);
    animation: fadeUp 0.55s ease forwards;
  }
  #value-resilience      { animation-delay: 0ms; }
  #value-balance         { animation-delay: 100ms; }
  #value-accountability  { animation-delay: 200ms; }
  #value-professionalism { animation-delay: 300ms; }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
